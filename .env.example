# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_DB=pawshome
POSTGRES_USER=pawsuser
POSTGRES_PASSWORD=change-me-strong-db-password

# Signing key shared by the API (JWT) and the web app (session cookie).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-signing-key

TOKEN_EXPIRE_MINUTES=60

# Origins allowed to call the API from a browser (comma separated).
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Public address the browser uses to reach the WebSocket endpoint.
WS_PUBLIC_URL=ws://localhost:8000/ws/notifications

MAX_UPLOAD_MB=5

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false
